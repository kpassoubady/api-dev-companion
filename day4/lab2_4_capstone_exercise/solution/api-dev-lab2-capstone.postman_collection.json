{
  "info": {
    "name": "API Dev Lab 2.4 - Capstone",
    "description": "Collection to test the FarewellController built in the Capstone lab.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. GET /api/v1/farewells/Learner",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/farewells/Learner",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "farewells", "Learner"]
        }
      }
    },
    {
      "name": "2. GET /api/v1/greetings/Learner",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/greetings/Learner",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "greetings", "Learner"]
        }
      }
    },
    {
      "name": "3. GET OpenAPI JSON Specification",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api-docs",
          "host": ["{{baseUrl}}"],
          "path": ["api-docs"]
        }
      }
    }
  ]
}
